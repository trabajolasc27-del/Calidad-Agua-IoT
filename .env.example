# Copiar este archivo como .env (o .env.local, según lo que use el proyecto Angular)
# y completar con valores reales. NUNCA subir el archivo .env real a Git.
# Ninguna clave con privilegios administrativos debe usarse desde el frontend.

# --- Supabase (frontend, claves públicas) ---
# Ver docs/MANUAL_ACTIONS.md #1 para obtener estos valores.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Supabase (solo backend / Edge Functions, NUNCA en el frontend) ---
# Estas variables se configuran como secretos del proyecto Supabase
# (supabase secrets set ...), no se escriben en este archivo con valores reales.
# SUPABASE_SERVICE_ROLE_KEY=
# BREVO_API_KEY=

# --- Notificaciones (Brevo) ---
# Correo/dominio remitente verificado. Ver docs/MANUAL_ACTIONS.md #2.
NOTIFICATIONS_SENDER_EMAIL=

# --- Simulador IoT (desarrollo) ---
SIMULATOR_TARGET_URL=
SIMULATOR_DEVICE_ID=
SIMULATOR_DEVICE_SECRET=
